# Copy this to .env (or export these as real env vars) before running the server.
# `go run .` does NOT read .env automatically — see README.md for two ways to load it.

PORT=8081
FRONTEND_URL=http://localhost:8080

# Any long random string. Used as a general secret-configured sanity check;
# generate one with: openssl rand -base64 32
SESSION_SECRET=

# --- Google OAuth ---------------------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Add http://localhost:8081/api/auth/google/callback
# as an Authorized redirect URI there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8081/api/auth/google/callback

# --- WebAuthn / Passkeys ---------------------------------------------------
# RP_ID must be the bare domain (no scheme/port) the frontend is served
# from. "localhost" works for local dev. In production this must be your
# real domain, e.g. "gatequest.com" (not "www.gatequest.com" unless that's
# literally what's in the address bar).
RP_ID=localhost
RP_DISPLAY_NAME=GATEquest
# Comma-separated list of exact origins (scheme + host + port) the frontend
# is served from. Must match RP_ID's domain.
RP_ORIGINS=http://localhost:8080

# --- Cookies ---------------------------------------------------------------
# Leave COOKIE_DOMAIN empty for localhost. Set COOKIE_SECURE=true in any
# real deployment (requires HTTPS).
COOKIE_DOMAIN=
COOKIE_SECURE=false
