# Copy this to .env for local dev (go run . loads it automatically).
# In production (Render/Fly/VPS), set these as real environment variables
# through that platform's dashboard/CLI instead of a file.

PORT=8081

# --- Database ---------------------------------------------------------
# Neon connection string. Neon dashboard > your project > Connect >
# copy the "Connection string" (pooled connection is fine and preferred
# for a server like this). Must include sslmode=require.
# e.g. postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# The exact origin your Vercel frontend is served from. Used for CORS and
# for redirecting back after Google OAuth completes. Must be an exact
# match, no trailing slash — e.g. https://gatequest.vercel.app
FRONTEND_URL=http://localhost:8080

# Any long random string. openssl rand -base64 32
SESSION_SECRET=

# --- Google OAuth ---------------------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Add {THIS_BACKEND_URL}/api/auth/google/callback as an
# Authorized redirect URI there — e.g.
# https://api.yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8081/api/auth/google/callback

# --- WebAuthn / Passkeys ---------------------------------------------------
# RP_ID must be the bare domain (no scheme/port) the FRONTEND is served
# from — passkeys are bound to the domain shown in the browser's address
# bar, not to this backend's domain. "localhost" for local dev; your real
# Vercel domain (e.g. "gatequest.vercel.app" or a custom domain) in prod.
RP_ID=localhost
RP_DISPLAY_NAME=GATEquest
# Comma-separated exact origins (scheme + host) the frontend is served
# from. Must match RP_ID's domain.
RP_ORIGINS=http://localhost:8080

# --- Cookies ---------------------------------------------------------------
# Leave both as-is for local dev. In production, set COOKIE_SECURE=true —
# this is required (frontend and backend are on different domains there,
# which needs SameSite=None cookies, which browsers only allow over HTTPS).
# Leave COOKIE_DOMAIN empty unless backend and frontend share a parent
# domain you specifically want to scope cookies to.
COOKIE_DOMAIN=
COOKIE_SECURE=false
